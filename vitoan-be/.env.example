PORT=9002
MONGO_URI=mongodb://127.0.0.1:27017/vitoan
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d
CLIENT_URL=http://localhost:5175
CORS_ALLOWED_ORIGINS=http://localhost:5175
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=ViToan <your_email@gmail.com>

# Trợ lý AI / gợi ý / nhận xét dùng Google Gemini (lấy key tại aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Xac thuc SDT bang OTP: console (in ra log BE) | speedsms | esms
SMS_PROVIDER=console
SPEEDSMS_TOKEN=
SPEEDSMS_TYPE=2
SPEEDSMS_SENDER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=8
ESMS_BRANDNAME=
ESMS_SANDBOX=0

# Twilio (gui duoc so quoc te; tai khoan dung thu chi gui toi so da xac thuc tren Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
